{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OFD Manager",
  "version": "0.2.0",
  "identifier": "com.ofdmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OFD Manager",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "resources": {
      "../../../crates/ofd-core/assets/fonts/*": "fonts/"
    },
    "shortDescription": "Cross-platform OFD document viewer and converter",
    "longDescription": "View, inspect, verify, and convert OFD documents to image-based PDF files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["ofd"],
        "mimeType": "application/ofd",
        "description": "Open Fixed-layout Document",
        "role": "Viewer"
      }
    ]
  }
}
